<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>myrouter</AssemblyName>
    <RootNamespace>myrouter</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>myrouter.ico</ApplicationIcon>
    <!-- 裁剪缩小自包含体积（发布/构建均生效；对 dev build 无副作用）
         _SuppressWinFormsTrimError：官方默认禁止 WinForms 裁剪（否则报 NETSDK1175），
         本应用实测裁剪后可正常启动（SmokeTest + 启动验证通过），故显式放开
         JsonSerializerIsReflectionEnabledByDefault：AppConfig 用 System.Text.Json 反射序列化
         （非 source-gen），裁剪必须保留该路径，否则 Load()/Save() 运行时会抛异常 -->
    <PublishTrimmed>true</PublishTrimmed>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- tests/ 是嵌套子项目目录，默认项收集会把它们的源码和 obj 一并编译进来，必须排除 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="myrouter.ico" />
    <!-- Web 界面单文件页面：打进 exe，浏览器访问 http://localhost:{port}/ 即用 -->
    <EmbeddedResource Include="content\index.html" />
    <!-- 前端第三方依赖（markdown-it + highlight.js + KaTeX，tools/vendor/build.mjs 可重新构建） -->
    <EmbeddedResource Include="tools\vendor\vendor.bundle.js" LogicalName="myrouter.vendor.js" />
    <!-- KaTeX 样式（字体 base64 内嵌，零外部请求） -->
    <EmbeddedResource Include="tools\vendor\katex.css" LogicalName="myrouter.katex.css" />
  </ItemGroup>

</Project>
